{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "serial-monitor-essential",
  "version": "0.1.0",
  "identifier": "io.github.771-8bit.serial-monitor-essential",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Serial Monitor Essential",
        "width": 730,
        "height": 600,
        "minWidth": 730,
        "minHeight": 450
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "publisher": "771-8bit",
    "targets": "all",
    "linux": {
      "deb": {
        "depends": ["libudev1", "libgudev-1.0-0"]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
